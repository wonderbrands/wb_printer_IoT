<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista del Wizard -->
    <record id="view_print_reason_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.print.reason.wizard.form</field>
        <field name="model">sale.order.print.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Motivo de Reimpresión">
                <group>
                    <field name="sale_order_id" readonly="1" force_save="1"/>
                    <field name="report_type" readonly="1" force_save="1"/>
                    <field name="print_reason" placeholder="Ej: Etiqueta dañada, cliente solicitó reenvío, etc."/>
                </group>
                <footer>
                    <button name="action_print" string="Imprimir" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Server Action: Guía Adjunta 4x8 (abre wizard) -->
    <record id="action_open_wizard_attachment_4x8" model="ir.actions.server">
        <field name="name">Data - Imprimir Guía Adjunta 4x8</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">wizard = env['sale.order.print.reason.wizard'].create({'sale_order_id': record.id, 'report_type': 'attachment_4x8'})
action = {'name': 'Motivo de Reimpresión - Guía Adjunta 4x8', 'type': 'ir.actions.act_window', 'res_model': 'sale.order.print.reason.wizard', 'res_id': wizard.id, 'view_mode': 'form', 'target': 'new'}</field>
    </record>

    <!-- Server Action: Etiqueta EI (abre wizard) -->
    <record id="action_open_wizard_etiqueta_ei" model="ir.actions.server">
        <field name="name">Data - Imprimir Etiqueta EI</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">wizard = env['sale.order.print.reason.wizard'].create({'sale_order_id': record.id, 'report_type': 'etiqueta_ei'})
action = {'name': 'Motivo de Reimpresión - Etiqueta EI', 'type': 'ir.actions.act_window', 'res_model': 'sale.order.print.reason.wizard', 'res_id': wizard.id, 'view_mode': 'form', 'target': 'new'}</field>
    </record>

</odoo>