<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Reporte combinado: Guías + Etiqueta ZPL (disparado desde barcode PACK) -->
    <record id="action_report_combined_pack_validate" model="ir.actions.report">
        <field name="name">Impresión Combinada (Guía + Etiqueta)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">wb_printer_IoT.report_combined_pack_validate</field>
        <field name="report_file">wb_printer_IoT.report_combined_pack_validate</field>
        <field name="binding_type">report</field>
    </record>

    <!-- Template placeholder (requerido por Odoo aunque el render es override completo) -->
    <record id="report_combined_pack_validate" model="ir.ui.view">
        <field name="name">report.combined.pack.validate</field>
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="wb_printer_IoT.report_combined_pack_validate">
                <t t-call="web.html_container">
                    <t t-foreach="docs" t-as="doc">
                        <p>Reporte combinado - contenido generado por override</p>
                    </t>
                </t>
            </t>
        </field>
    </record>
</odoo>