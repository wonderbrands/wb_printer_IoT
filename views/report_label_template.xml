<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_custom_2x1_document">
        
        <t t-if="o.attachments">
            <t t-foreach="o.attachments" t-as="attach">
                
                <div class="page" style="margin: 0; padding: 0; width: 100%; height: 100%; background-color: white; color: black; font-family: sans-serif; overflow: hidden; page-break-after: always;">
                    
                    <div style="text-align: center; padding-top: 2mm;">
                        <strong style="font-size: 14px;" t-esc="attach.display_name_custom"/>
                    </div>
                    
                    <div style="text-align: center; font-size: 10px; margin-top: 0.5mm;">
                        <span t-if="o.team_id" t-esc="o.team_id.name"/>
                        <span t-else="">Sin equipo de ventas</span>
                    </div>
                    
                    <div style="text-align: center; margin-top: 1mm;">
                        <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', attach.display_name_custom, 300, 50)" 
                             style="width: 90%; max-height: 25px;" alt="Código de Barras"/>
                    </div>

                </div>
            </t>
        </t>

        <t t-else="">
            <div class="page" style="margin: 0; padding: 0; width: 100%; height: 100%; background-color: white; color: black; font-family: sans-serif; overflow: hidden;">
                <div style="text-align: center; padding-top: 2mm;">
                    <strong style="font-size: 12px;">Sin Guías</strong><br/>
                    <span t-field="o.name" style="font-size: 14px; font-weight: bold;"/><br/>
                    <span t-if="o.team_id" t-esc="o.team_id.name" style="font-size: 10px;"/>
                </div>
            </div>
        </t>

    </template>
    
    <template id="report_custom_2x1">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="wb_printer_IoT.report_custom_2x1_document"/>
            </t>
        </t>
    </template>
</odoo>